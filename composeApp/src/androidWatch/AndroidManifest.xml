<?xml version="1.0" encoding="utf-8"?>
<!-- Flavor "watch" (Wear OS): solo se instala en relojes y funciona sin el móvil. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.type.watch" />
    <application>
        <!-- App de reloj independiente: no necesita una app compañera en el teléfono. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />
    </application>
</manifest>
